# Base URL of the NEXA AI backend, including the API prefix.
# Leave unset for local dev (defaults to http://127.0.0.1:8000/api/v1).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Google OAuth client id (Google Cloud Console > Credentials). Same value
# as GOOGLE_CLIENT_ID in the backend .env. Leave empty to hide the
# "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
